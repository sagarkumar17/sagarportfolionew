# Contact form
# When set, the Contact form POSTs to Formspree.
# Create a form at https://formspree.io/ and paste the form id (e.g. xyzabcde).
NEXT_PUBLIC_FORMSPREE_ID=

# Optional override for the mailto fallback address (defaults to site.email).
# NEXT_PUBLIC_CONTACT_EMAIL=hello@sagarkumar.site

# Future: Resend API route stub (server-only — never expose the key to the client)
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=hello@sagarkumar.site
